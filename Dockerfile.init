FROM python:3.12.16-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337

WORKDIR /app
COPY requirements-init.txt /app/requirements.txt
COPY scripts/check_lock.py /app/check_lock.py
RUN python -m pip install --no-index --no-deps -r /app/requirements.txt && python /app/check_lock.py /app/requirements.txt
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home app
COPY --chown=10001:10001 src/download_model.py /app/download_model.py
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp
USER 10001:10001
ENTRYPOINT ["python", "/app/download_model.py"]
