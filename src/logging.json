{
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {
    "safe": {"()": "privacy.SafeFormatter"}
  },
  "handlers": {
    "safe": {
      "class": "logging.StreamHandler",
      "formatter": "safe",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {"level": "WARNING", "handlers": ["safe"]},
  "loggers": {
    "vllm": {"level": "INFO", "handlers": ["safe"], "propagate": false},
    "uvicorn": {"level": "INFO", "handlers": ["safe"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["safe"], "propagate": false},
    "uvicorn.access": {"level": "WARNING", "handlers": ["safe"], "propagate": false},
    "audit": {"level": "INFO", "handlers": ["safe"], "propagate": false}
  }
}
