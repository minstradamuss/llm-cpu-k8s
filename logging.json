{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "stream": "ext://sys.stdout",
      "formatter": "safe"
    }
  },
  "root": {"level": "WARNING", "handlers": ["console"]},
  "loggers": {
    "vllm": {"level": "WARNING", "handlers": ["console"], "propagate": false},
    "uvicorn": {"level": "WARNING", "handlers": ["console"], "propagate": false},
    "uvicorn.error": {"level": "WARNING", "handlers": ["console"], "propagate": false},
    "uvicorn.access": {"level": "CRITICAL", "handlers": [], "propagate": false},
    "safe_requests": {"level": "INFO", "handlers": ["console"], "propagate": false}
  }
}
